# Local development defaults
PORT=5000
JWT_SECRET=change-me-for-production
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-for-production
EMAIL_USER=your-smtp-account@example.com
EMAIL_PASS=your-smtp-password
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# For cPanel, point this to a writable persistent path outside the deployed code directory
# Example: /home/your-cpanel-user/data/imsolutions.db
DB_PATH=
